# Puerto donde escucha la API HTTP interna del bot (la consume api/src/Core/WhatsAppClient.php)
WA_PORT=3001

# Clave secreta compartida con PHP (header X-WA-Secret). Tiene que ser
# EXACTAMENTE la misma que WA_SECRET en el .env del sitio (raíz del proyecto).
WA_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
